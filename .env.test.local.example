# Base de test dédiée — copier ce fichier en .env.test.local (jamais versionné)
# puis lancer : npm run test:db:setup
#
# Une base À PART, jamais celle de .env.local : le peuplement de test efface
# les clients, animaux, rendez-vous et prestations. Le script refuse la base de
# développement et toute base non vide qui ne porte pas la marque « test ».

# Adresse d'un projet Neon dédié aux tests (ou de tout PostgreSQL joignable).
DATABASE_URL="postgresql://utilisateur:motdepasse@hote/base?sslmode=require"

# Secret propre aux tests (n'importe quelle chaîne longue et aléatoire) :
# chiffre les sessions du serveur de test.
SESSION_SECRET="remplacer-par-une-chaine-aleatoire-de-64-caracteres"

# Permet à tests/appointment-reminders.spec.ts de déclencher les tâches de fond.
CRON_SECRET="remplacer-par-une-autre-chaine-aleatoire"
