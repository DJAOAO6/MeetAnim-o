DATABASE_URL=

AUTH_EMAIL=
AUTH_PASSWORD_HASH_BASE64=
SESSION_SECRET=

# Optionnel : sans ces variables, les emails (2FA, mot de passe oublié,
# invitations) sont simplement affichés dans les logs du serveur (mode dev).
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# URL publique de l'app, utilisée dans les liens envoyés par email.
NEXT_PUBLIC_APP_URL=http://localhost:3000
