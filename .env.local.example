DATABASE_URL=

AUTH_EMAIL=
AUTH_PASSWORD_HASH_BASE64=
SESSION_SECRET=

# Optionnel : sans ces variables, les emails (2FA, mot de passe oublié,
# invitations) sont simplement affichés dans les logs du serveur (mode dev).
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# URL publique de l'app, utilisée dans les liens envoyés par email.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Intégrations calendrier (Google Agenda) — voir docs/GOOGLE-CALENDAR-SETUP.md
# pour la configuration complète de Google Cloud. Sans ces variables, le
# bouton "Connecter Google Agenda" échoue explicitement (jamais un
# comportement silencieux) ; le reste du logiciel continue de fonctionner
# normalement.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clé de chiffrement des jetons OAuth (access/refresh token) avant stockage
# en base — jamais en clair. Génération recommandée :
#   openssl rand -hex 32
# Ne JAMAIS changer cette valeur une fois des comptes connectés : les jetons
# déjà chiffrés deviendraient illisibles (déconnecter/reconnecter les
# intégrations concernées après une rotation de clé).
CALENDAR_TOKEN_ENCRYPTION_KEY=
