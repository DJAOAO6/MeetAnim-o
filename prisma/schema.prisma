generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClientStatus {
  ACTIF
  INACTIF
}

enum VisitMode {
  CABINET
  DOMICILE
}

enum ConsultationStatus {
  TERMINE
  ANNULE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ReminderStatus {
  DUE
  SENT
  BOOKED
  IGNORED
  UPCOMING
}

enum ReminderDelay {
  THREE_MONTHS
  SIX_MONTHS
  TWELVE_MONTHS
  CUSTOM
}

enum DocumentType {
  PDF
  IMAGE
}

enum TourStatus {
  ACTIVE
  INACTIVE
}

enum TourStartType {
  CABINET
  CUSTOM
}

enum TravelFeeMode {
  FIXED
  ZONE
  KILOMETRIC
}

enum UserRole {
  ADMIN
  PRACTITIONER
  SECRETARY
}

enum TwoFactorMethod {
  EMAIL
  // TOTP prévu pour une évolution future (Google Authenticator, etc.)
}

enum CalendarProviderKind {
  GOOGLE
  MICROSOFT
  APPLE
}

enum CalendarSyncStatus {
  SYNCED
  PENDING
  ERROR
}

// Point de départ/arrivée d'une TourRun. FAVORITE référence un SavedPlace ;
// CURRENT_LOCATION est résolu côté client (géolocalisation navigateur) puis
// envoyé comme des coordonnées CUSTOM au moment de la sauvegarde — jamais
// suivi en continu, jamais stocké tel quel.
enum TourEndpointType {
  CABINET
  HOME
  FAVORITE
  CUSTOM
  CURRENT_LOCATION
  LAST_APPOINTMENT
  SAME_AS_START
}

enum TourStopType {
  APPOINTMENT
  BREAK
  MEAL
  CABINET
  HOME
  CLINIC
  STABLE
  SUPPLIER
  OTHER
}

enum SavedPlaceType {
  CABINET
  HOME
  CLINIC
  STABLE
  OTHER
}

enum OptimizationPreference {
  TIME
  DISTANCE
  BALANCED
}

enum AuditAction {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  TWO_FACTOR_CODE_SENT
  TWO_FACTOR_VERIFIED
  TWO_FACTOR_FAILED
  CLIENT_VIEWED
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_DELETED
  CLIENT_DATA_EXPORTED
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  APPOINTMENT_CREATED
  APPOINTMENT_UPDATED
  APPOINTMENT_STATUS_CHANGED
  ANIMAL_DELETED
  ANIMAL_UPDATED
  REMINDER_CREATED
  REMINDER_UPDATED
  REMINDER_SENT
  REMINDER_IGNORED
  CALENDAR_CONNECTED
  CALENDAR_DISCONNECTED
  CALENDAR_SETTINGS_UPDATED
  CALENDAR_FEED_TOKEN_REGENERATED
}

model User {
  id                String          @id @default(cuid())
  email             String          @unique
  passwordHash      String
  firstName         String
  lastName          String
  role              UserRole        @default(PRACTITIONER)
  permissions       String[]        @default([])
  active            Boolean         @default(true)
  twoFactorEnabled  Boolean         @default(false)
  twoFactorMethod   TwoFactorMethod @default(EMAIL)
  passwordChangedAt DateTime        @default(now())
  lastLoginAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Abonnement ICS privé (Apple Calendar et assimilés) : un jeton par
  // utilisateur, jamais l'id utilisateur directement dans l'URL du flux
  // (intégrations calendrier — voir docs/GOOGLE-CALENDAR-SETUP.md). Absent
  // tant que l'utilisateur n'a jamais généré son lien.
  icsFeedToken String? @unique

  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  twoFactorCodes      TwoFactorCode[]
  blockedSlots        BlockedSlot[]
  calendarConnections CalendarConnection[]
  tourRuns            TourRun[]
  savedPlaces         SavedPlace[]
  tourPreferences     TourPreferences?

  @@index([email])
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model TwoFactorCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RateLimitEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Client {
  id        String       @id @default(cuid())
  firstName String
  lastName  String
  phone     String
  email     String
  city      String
  address   String
  status    ClientStatus @default(ACTIF)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  animals      Animal[]
  appointments Appointment[]
  reminders    Reminder[]

  @@index([lastName, firstName])
  @@index([email])
}

model Animal {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name                 String
  species              String
  breed                String
  age                  String
  birthDate            DateTime?
  birthDateApproximate Boolean   @default(false)
  weight               String
  sex                  String
  avatar               String
  avatarBackground     String
  photo                String?

  history    String @db.Text
  conditions String @db.Text
  treatments String @db.Text
  notes      String @db.Text

  reminderLabel String?
  reminderDate  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultations Consultation[]
  documents     AnimalDocument[]
  appointments  Appointment[]
  reminders     Reminder[]

  @@index([clientId])
}

model Consultation {
  id       String @id @default(cuid())
  animalId String
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  date    DateTime
  service String
  mode    VisitMode
  price   Float
  summary String             @db.Text
  status  ConsultationStatus @default(TERMINE)

  createdAt DateTime @default(now())

  @@index([animalId])
}

model AnimalDocument {
  id       String       @id @default(cuid())
  animalId String
  animal   Animal       @relation(fields: [animalId], references: [id], onDelete: Cascade)
  name     String
  type     DocumentType
  linkedTo String

  createdAt DateTime @default(now())

  @@index([animalId])
}

model Appointment {
  id       String  @id @default(cuid())
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  animalId String?
  animal   Animal? @relation(fields: [animalId], references: [id], onDelete: SetNull)

  clientName    String
  animalName    String
  animalSpecies String?
  serviceName   String
  date          DateTime
  start         String
  duration      Int
  mode          VisitMode
  location      String
  postalCode    String?
  city          String?
  inseeCode     String?
  latitude      Float?
  longitude     Float?
  price         Float
  status        AppointmentStatus @default(PENDING)
  notes         String            @db.Text
  // Horodatage réel de clôture (bouton "Consultation réalisée"), distinct de
  // updatedAt qui bouge à chaque modification du rendez-vous — sert au mode
  // tournée (refonte tournées, phase 2) pour l'indicateur de retard et
  // l'heure de fin réelle affichée sous un arrêt terminé.
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calendarEvents AppointmentCalendarEvent[]
  tourStops      TourStop[]

  @@index([clientId])
  @@index([animalId])
  @@index([date])
}

/**
 * Intégrations calendrier externes (Google/Microsoft/Apple), rattachées à
 * l'utilisateur qui les a connectées — pas au cabinet (BusinessProfile,
 * toujours un singleton dans cette version, voir docs) : chaque membre du
 * staff connecte son propre compte. Provider-agnostique dès le départ
 * (CalendarProviderKind) pour ne pas avoir à reprendre ce modèle quand
 * Microsoft sera implémenté — voir src/lib/calendar/types.ts.
 */
model CalendarConnection {
  id       String               @id @default(cuid())
  userId   String
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider CalendarProviderKind

  providerAccountId String
  accountEmail      String

  calendarId   String
  calendarName String

  // Chiffrés (AES-256-GCM, voir calendar-encryption.ts) — jamais en clair en
  // base, jamais exposés au navigateur, jamais journalisés.
  accessTokenEncrypted  String   @db.Text
  refreshTokenEncrypted String   @db.Text
  accessTokenExpiresAt  DateTime

  syncAppointments       Boolean @default(true)
  syncUpdates            Boolean @default(true)
  deleteCancelledEvents  Boolean @default(true)
  blockExternalBusySlots Boolean @default(true)

  connectedAt DateTime  @default(now())
  lastSyncAt  DateTime?
  lastError   String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events AppointmentCalendarEvent[]

  // Empêche deux connexions dupliquées pour le même provider chez le même
  // utilisateur (reconnecter remplace la ligne existante plutôt que d'en
  // créer une seconde).
  @@unique([userId, provider])
  @@index([userId])
}

/**
 * Table de liaison générique (plutôt qu'un simple externalCalendarEventId
 * sur Appointment) : un même rendez-vous peut un jour être synchronisé vers
 * plusieurs connexions (deux membres du staff qui se partagent l'agenda),
 * et chaque provider aura son propre identifiant d'événement externe.
 */
model AppointmentCalendarEvent {
  id            String             @id @default(cuid())
  appointmentId String
  appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  connectionId  String
  connection    CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  externalEventId String

  status     CalendarSyncStatus @default(SYNCED)
  lastError  String?            @db.Text
  lastSyncAt DateTime           @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appointmentId, connectionId])
  @@index([connectionId])
}

model BlockedSlot {
  id        String   @id @default(cuid())
  date      DateTime
  startTime String
  endTime   String
  reason    String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([date])
}

model Reminder {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  animalId String
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  lastConsultation DateTime
  delay            ReminderDelay
  dueDate          DateTime
  status           ReminderStatus @default(DUE)
  note             String?        @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([animalId])
}

model Zone {
  id           String @id @default(cuid())
  name         String
  cities       City[]
  tours        Tour[]
  // Multi-zone (refonte tournées, formulaire enrichi) : source de vérité
  // pour le nouveau sélecteur multi-zone. `tours` (ci-dessus, relation
  // zoneId simple) reste inchangée pour ne rien casser côté existant.
  toursInZones Tour[] @relation("TourZones")
}

model City {
  id         String @id @default(cuid())
  name       String
  postalCode String
  zoneId     String
  zone       Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
}

/**
 * appointmentCount/consultationHours ne sont plus des colonnes stockées
 * (AUDIT_COMPLET.md P2-25) : figées à 0/"0h" pour toute tournée créée via
 * l'app réelle (jamais mises à jour), elles sont désormais calculées à la
 * lecture depuis les vrais Appointment de la prochaine occurrence de la
 * tournée (voir src/lib/tours.ts). Même sort pour estimatedKm depuis la
 * refonte tournées (phase 1.3) : la colonne reste en base (des lectures
 * historiques peuvent encore l'utiliser, ex. les statistiques annuelles),
 * mais l'app ne la lit/écrit plus nulle part — la distance affichée est
 * recalculée à la volée depuis les vraies coordonnées géocodées des arrêts
 * et du cabinet (src/lib/tour-estimate.ts).
 */
model Tour {
  id          String     @id @default(cuid())
  name        String
  // Valeurs actuelles : "Toutes les semaines" | "Toutes les deux semaines" |
  // "Tous les mois" | "Une seule fois" — voir src/lib/tour-schedule.ts pour
  // le calcul de prochaine occurrence de chaque motif. "Une seule fois" =
  // ponctuelle ; les trois autres = récurrente (le formulaire regroupe ces
  // deux notions dans ce même champ, pas de colonne "type" séparée).
  recurrence  String
  day         String
  // Ancre : date de la première occurrence pour un motif récurrent
  // (quinzaine/mois — nécessaire pour calculer la parité de semaine / le
  // jour du mois), date exacte pour une tournée ponctuelle. Optionnel pour
  // rester rétrocompatible avec les tournées hebdomadaires existantes,
  // créées avant que ce champ ne devienne obligatoire pour les nouveaux
  // motifs.
  dateId      String?
  dateLabel   String
  startTime   String
  endTime     String
  zoneId      String
  zone        Zone       @relation(fields: [zoneId], references: [id])
  // Multi-zone (nouveau formulaire) : source de vérité pour l'affichage et
  // le rattachement des rendez-vous. zoneId/zone ci-dessus ne sont jamais
  // lus par le nouveau formulaire — conservés uniquement pour ne rien
  // casser côté existant (auto-renseignés à la première zone sélectionnée
  // à chaque sauvegarde, voir tours-actions.ts).
  zones       Zone[]     @relation("TourZones")
  status      TourStatus @default(ACTIVE)
  estimatedKm Float      @default(0)

  startType      TourStartType @default(CABINET)
  startAddress   String?
  startLatitude  Float?
  startLongitude Float?
  // Limite douce (avertit, ne bloque jamais l'ajout d'un arrêt) — absente = pas de limite.
  maxStops       Int?
  note           String?       @db.Text

  @@index([zoneId])
}

model BusinessProfile {
  id                       String   @id @default(cuid())
  slug                     String   @unique
  firstName                String
  lastName                 String
  profession               String
  company                  String
  phone                    String
  email                    String
  address                  String
  postalCode               String
  city                     String
  location                 String
  latitude                 Float?
  longitude                Float?
  bio                      String   @db.Text
  photo                    String   @db.Text
  logo                     String   @db.Text
  publicColor              String
  cabinetAvailable         Boolean  @default(true)
  homeAvailable            Boolean  @default(true)
  availability             Json?
  reminderSettings         Json?
  // Page publique de réservation — refonte profil (2026-09) : le "bio"
  // existant devient le contenu détaillé de "À propos" ; tagline est le
  // texte très court affiché dans le bandeau d'en-tête, pour ne jamais
  // dupliquer le même texte à deux endroits.
  tagline                  String?
  coverPicture             String?  @db.Text
  website                  String?
  facebook                 String?
  instagram                String?
  registrationNumber       String?
  acceptedPayments         String?
  cabinetName              String?
  cabinetInstructions      String?  @db.Text
  parkingInformation       String?  @db.Text
  accessibilityInformation String?  @db.Text
  showPhonePublicly        Boolean  @default(true)
  showAddressPublicly      Boolean  @default(true)
  showHoursPublicly        Boolean  @default(true)
  showSocialsPublicly      Boolean  @default(true)
  showPaymentsPublicly     Boolean  @default(true)
  updatedAt                DateTime @updatedAt
}

model Service {
  id                String        @id @default(cuid())
  name              String
  description       String        @db.Text
  duration          Int
  animals           String[]
  cabinetEnabled    Boolean       @default(true)
  cabinetPrice      Float
  homeEnabled       Boolean       @default(true)
  homePrice         Float
  travelFeesEnabled Boolean       @default(false)
  travelFeeMode     TravelFeeMode @default(FIXED)
  fixedTravelFee    Float         @default(0)
  zoneFees          Json?
  kilometricRate    Float         @default(0)
  suggestedReminder String
  active            Boolean       @default(true)
  // Photo illustrant la prestation sur la page de réservation publique (data
  // URI uploadée par le professionnel, même convention que les autres champs
  // image de l'app) ; à défaut, une photo générique par espèce est utilisée.
  photoUrl          String?       @db.Text
  createdAt         DateTime      @default(now())
}

/**
 * Tournée datée concrète (éditeur interactif — carte + timeline), distincte
 * du modèle `Tour` existant (gabarit récurrent par zone, utilisé par la
 * grille "Tournées"/relances par zone — reste inchangé, les deux systèmes
 * coexistent). Rattachée à l'utilisateur qui l'a créée : "ma tournée" reste
 * personnelle (départ/arrivée typiquement domicile/cabinet d'une personne),
 * même principe que CalendarConnection.
 * routeGeometry/totalDistanceMeters/totalDurationSeconds sont un cache du
 * dernier calcul d'itinéraire réussi (openrouteservice) — jamais la source
 * de vérité : recalculés dès qu'un arrêt/départ/arrivée/option change,
 * conservés seulement pour un rendu instantané à l'ouverture sans attendre
 * un nouvel appel réseau, et pour rester utilisables si l'API est
 * temporairement indisponible (la tournée reste éditable/sauvegardable).
 */
model TourRun {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  date          DateTime
  // Heure de départ effective (HH:mm) — sert de point de départ au chaînage
  // des heures d'arrivée/départ de chaque TourStop. Absente : on retombe sur
  // TourPreferences.workHoursStart au moment du calcul, jamais stockée en
  // dur ici pour ne pas devoir la resynchroniser si les préférences changent.
  departureTime String?

  startType         TourEndpointType
  startLabel        String?
  startAddress      String?
  startLatitude     Float?
  startLongitude    Float?
  startSavedPlaceId String?
  startSavedPlace   SavedPlace?      @relation("TourRunStart", fields: [startSavedPlaceId], references: [id], onDelete: SetNull)

  endType         TourEndpointType
  endLabel        String?
  endAddress      String?
  endLatitude     Float?
  endLongitude    Float?
  endSavedPlaceId String?
  endSavedPlace   SavedPlace?      @relation("TourRunEnd", fields: [endSavedPlaceId], references: [id], onDelete: SetNull)

  totalDistanceMeters  Int?
  totalDurationSeconds Int?
  routeGeometry        Json?
  routeComputedAt      DateTime?

  safetyBufferMinutes Int     @default(10)
  lunchBreakEnabled   Boolean @default(false)
  lunchBreakStart     String?
  lunchBreakEnd       String?

  optimizationPreference OptimizationPreference @default(BALANCED)
  avoidTolls             Boolean                @default(false)
  avoidHighways          Boolean                @default(false)
  avoidFerries           Boolean                @default(false)

  // Dernière proposition d'optimisation calculée (ordre proposé + gains) —
  // affichée pour comparaison, jamais appliquée automatiquement (voir
  // TourStop.order, qui seul reflète la tournée réellement retenue).
  lastOptimizationProposal Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stops TourStop[]

  @@index([userId, date])
}

model TourStop {
  id        String  @id @default(cuid())
  tourRunId String
  tourRun   TourRun @relation(fields: [tourRunId], references: [id], onDelete: Cascade)

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  order Int
  type  TourStopType

  // Snapshot au moment de l'ajout (voir doc snapshot vs lien vivant) : le
  // libellé/l'adresse affichés dans la tournée ne bougent pas si le client
  // déménage ensuite — seules les coordonnées servent au recalcul
  // d'itinéraire. Pour un arrêt lié à un Appointment, label/adresse sont
  // pré-remplis depuis celui-ci à l'ajout puis vivent indépendamment.
  label     String
  address   String?
  latitude  Float?
  longitude Float?

  arrivalTime            String?
  departureTime          String?
  serviceDurationMinutes Int?

  flexible        Boolean @default(false)
  locked          Boolean @default(true)
  timeWindowStart String?
  timeWindowEnd   String?

  legDistanceMeters  Int?
  legDurationSeconds Int?

  // Écart en minutes entre l'heure d'arrivée réellement atteignable (calcul
  // du trajet depuis l'arrêt précédent) et l'heure fixe du rendez-vous —
  // positif seulement si le trajet arrive effectivement en retard. Calculé
  // par recomputeStopTimings (tour-runs-actions.ts) à chaque recalcul
  // d'itinéraire, jamais saisi manuellement ; null tant qu'aucun retard
  // n'est détecté ou que l'arrêt n'est pas fixe.
  lateWarningMinutes Int?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tourRunId, order])
  @@index([tourRunId])
  @@index([appointmentId])
}

model SavedPlace {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label     String
  type      SavedPlaceType
  address   String
  latitude  Float
  longitude Float

  isDefaultStart Boolean @default(false)
  isDefaultEnd   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  startOfTourRuns TourRun[] @relation("TourRunStart")
  endOfTourRuns   TourRun[] @relation("TourRunEnd")

  @@index([userId])
}

/**
 * Réglages globaux par utilisateur (valeurs par défaut uniquement) — une
 * TourRun peut toujours surcharger localement sans jamais modifier cette
 * ligne (voir doc "surcharge par tournée").
 */
model TourPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  defaultStartType         TourEndpointType @default(CABINET)
  defaultStartSavedPlaceId String?
  defaultEndType           TourEndpointType @default(CABINET)
  defaultEndSavedPlaceId   String?
  returnToStart            Boolean          @default(false)

  safetyBufferMinutes Int @default(10)

  lunchBreakEnabled Boolean @default(false)
  lunchBreakStart   String  @default("12:00")
  lunchBreakEnd     String  @default("13:00")

  workHoursStart String @default("08:00")
  workHoursEnd   String @default("19:00")

  optimizationPreference OptimizationPreference @default(BALANCED)
  avoidTolls             Boolean                @default(false)
  avoidHighways          Boolean                @default(false)
  avoidFerries           Boolean                @default(false)

  updatedAt DateTime @updatedAt
}
