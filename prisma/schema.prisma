generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClientStatus {
  ACTIF
  INACTIF
}

enum VisitMode {
  CABINET
  DOMICILE
}

enum ConsultationStatus {
  TERMINE
  ANNULE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ReminderStatus {
  DUE
  SENT
  BOOKED
  IGNORED
  UPCOMING
}

enum ReminderDelay {
  THREE_MONTHS
  SIX_MONTHS
  TWELVE_MONTHS
  CUSTOM
}

enum DocumentType {
  PDF
  IMAGE
}

enum TourStatus {
  ACTIVE
  INACTIVE
}

enum TravelFeeMode {
  FIXED
  ZONE
  KILOMETRIC
}

enum UserRole {
  ADMIN
  PRACTITIONER
  SECRETARY
}

enum TwoFactorMethod {
  EMAIL
  // TOTP prévu pour une évolution future (Google Authenticator, etc.)
}

enum AuditAction {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  TWO_FACTOR_CODE_SENT
  TWO_FACTOR_VERIFIED
  TWO_FACTOR_FAILED
  CLIENT_VIEWED
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_DELETED
  CLIENT_DATA_EXPORTED
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  APPOINTMENT_CREATED
  APPOINTMENT_UPDATED
  APPOINTMENT_STATUS_CHANGED
  ANIMAL_DELETED
  ANIMAL_UPDATED
  REMINDER_CREATED
  REMINDER_UPDATED
  REMINDER_SENT
  REMINDER_IGNORED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  firstName         String
  lastName          String
  role              UserRole  @default(PRACTITIONER)
  permissions       String[]  @default([])
  active            Boolean   @default(true)
  twoFactorEnabled  Boolean   @default(false)
  twoFactorMethod   TwoFactorMethod @default(EMAIL)
  passwordChangedAt DateTime  @default(now())
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  twoFactorCodes      TwoFactorCode[]
  blockedSlots        BlockedSlot[]

  @@index([email])
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model TwoFactorCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RateLimitEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Client {
  id        String       @id @default(cuid())
  firstName String
  lastName  String
  phone     String
  email     String
  city      String
  address   String
  status    ClientStatus @default(ACTIF)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  animals      Animal[]
  appointments Appointment[]
  reminders    Reminder[]

  @@index([lastName, firstName])
  @@index([email])
}

model Animal {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name             String
  species          String
  breed            String
  age              String
  birthDate            DateTime?
  birthDateApproximate Boolean   @default(false)
  weight           String
  sex              String
  avatar           String
  avatarBackground String
  photo            String?

  history    String @db.Text
  conditions String @db.Text
  treatments String @db.Text
  notes      String @db.Text

  reminderLabel String?
  reminderDate  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultations Consultation[]
  documents     AnimalDocument[]
  appointments  Appointment[]
  reminders     Reminder[]

  @@index([clientId])
}

model Consultation {
  id       String @id @default(cuid())
  animalId String
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  date    DateTime
  service String
  mode    VisitMode
  price   Float
  summary String              @db.Text
  status  ConsultationStatus  @default(TERMINE)

  createdAt DateTime @default(now())

  @@index([animalId])
}

model AnimalDocument {
  id       String       @id @default(cuid())
  animalId String
  animal   Animal       @relation(fields: [animalId], references: [id], onDelete: Cascade)
  name     String
  type     DocumentType
  linkedTo String

  createdAt DateTime @default(now())

  @@index([animalId])
}

model Appointment {
  id       String  @id @default(cuid())
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  animalId String?
  animal   Animal? @relation(fields: [animalId], references: [id], onDelete: SetNull)

  clientName    String
  animalName    String
  animalSpecies String?
  serviceName   String
  date        DateTime
  start       String
  duration    Int
  mode        VisitMode
  location    String
  postalCode  String?
  city        String?
  inseeCode   String?
  latitude    Float?
  longitude   Float?
  price       Float
  status      AppointmentStatus @default(PENDING)
  notes       String            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([animalId])
  @@index([date])
}

model BlockedSlot {
  id        String   @id @default(cuid())
  date      DateTime
  startTime String
  endTime   String
  reason    String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([date])
}

model Reminder {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  animalId String
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  lastConsultation DateTime
  delay            ReminderDelay
  dueDate          DateTime
  status           ReminderStatus @default(DUE)
  note             String?        @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([animalId])
}

model Zone {
  id     String @id @default(cuid())
  name   String
  cities City[]
  tours  Tour[]
}

model City {
  id         String @id @default(cuid())
  name       String
  postalCode String
  zoneId     String
  zone       Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
}

/**
 * appointmentCount/consultationHours ne sont plus des colonnes stockées
 * (AUDIT_COMPLET.md P2-25) : figées à 0/"0h" pour toute tournée créée via
 * l'app réelle (jamais mises à jour), elles sont désormais calculées à la
 * lecture depuis les vrais Appointment de la prochaine occurrence de la
 * tournée (voir src/lib/tours.ts). Même sort pour estimatedKm depuis la
 * refonte tournées (phase 1.3) : la colonne reste en base (des lectures
 * historiques peuvent encore l'utiliser, ex. les statistiques annuelles),
 * mais l'app ne la lit/écrit plus nulle part — la distance affichée est
 * recalculée à la volée depuis les vraies coordonnées géocodées des arrêts
 * et du cabinet (src/lib/tour-estimate.ts).
 */
model Tour {
  id          String     @id @default(cuid())
  name        String
  recurrence  String
  day         String
  dateId      String?
  dateLabel   String
  startTime   String
  endTime     String
  zoneId      String
  zone        Zone       @relation(fields: [zoneId], references: [id])
  status      TourStatus @default(ACTIVE)
  estimatedKm Float      @default(0)

  @@index([zoneId])
}

model BusinessProfile {
  id               String   @id @default(cuid())
  slug             String   @unique
  firstName        String
  lastName         String
  profession       String
  company          String
  phone            String
  email            String
  address          String
  postalCode       String
  city             String
  location         String
  latitude         Float?
  longitude        Float?
  bio              String   @db.Text
  photo            String   @db.Text
  logo             String   @db.Text
  publicColor      String
  cabinetAvailable Boolean  @default(true)
  homeAvailable    Boolean  @default(true)
  availability     Json?
  reminderSettings Json?
  updatedAt        DateTime @updatedAt
}

model Service {
  id                String        @id @default(cuid())
  name              String
  description       String        @db.Text
  duration          Int
  animals           String[]
  cabinetEnabled    Boolean       @default(true)
  cabinetPrice      Float
  homeEnabled       Boolean       @default(true)
  homePrice         Float
  travelFeesEnabled Boolean       @default(false)
  travelFeeMode     TravelFeeMode @default(FIXED)
  fixedTravelFee    Float         @default(0)
  zoneFees          Json?
  kilometricRate    Float         @default(0)
  suggestedReminder String
  active            Boolean       @default(true)
  // Photo illustrant la prestation sur la page de réservation publique (data
  // URI uploadée par le professionnel, même convention que les autres champs
  // image de l'app) ; à défaut, une photo générique par espèce est utilisée.
  photoUrl          String?       @db.Text
  createdAt         DateTime      @default(now())
}
